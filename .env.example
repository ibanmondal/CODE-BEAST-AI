# ========================================================
# CodeBeast AI - Production Environment Configuration Guide
# ========================================================

# --- [1] LLM Agent Intelligence API Keys ---
# Groq Cloud API Key (Required for 500+ tokens/sec multi-agent consensus)
# Obtain at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub Personal Access Token (Required for cloning public/private repos without rate-limits)
# Obtain at: https://github.com/settings/tokens (Fine-grained or classic with 'repo' scope)
GITHUB_TOKEN=ghp_your_github_token_here

# NaraRouter API Key (Optional fallback router for multi-model synthesis)
NARAROUTER_API_KEY=your_nararouter_key_optional

# --- [2] Database Configuration ---
# PostgreSQL connection string
# Production example: postgresql://postgres:password@localhost:5432/codebeast
# Supabase example:   postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Local SQLite default: sqlite:///./codebeast.db (auto-falls back if unreachable)
DATABASE_URL=sqlite:///./codebeast.db

# --- [3] Distributed Worker & Broker Configuration ---
# Redis broker URL for Celery and WebSocket event broadcasting
# Production example: redis://redis:6379/0
# Upstash example:    rediss://default:token@region.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# --- [4] Frontend Public Configuration ---
# Production API Base URL (leave empty on Vercel if using Next.js rewrites, or set to your Render/Railway backend URL)
# Example: https://codebeast-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production WebSocket Base URL
# Example: wss://codebeast-api.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000
