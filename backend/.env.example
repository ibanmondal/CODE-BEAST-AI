PROJECT_NAME="CodeBeast"

# Database Configuration (matches docker-compose)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="codebeast"

# Redis
REDIS_URL="redis://localhost:6379/0"

# --- API KEYS (Strictly Groq and NaraRouter) ---
# REQUIRED: Your GitHub Personal Access Token
# This prevents rate-limiting when the Context Builder pulls repository metadata.
GITHUB_TOKEN="your_github_personal_access_token_here"

# REQUIRED: Groq Cloud API Key (Llama 3.3 70B & Qwen)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# REQUIRED: NaraRouter API Key (Agnes 2.5 Flash / Router by Nara)
NARAROUTER_API_KEY="sk-nry-your_nararouter_api_key_here"

