PROJECT_NAME="CodeBeast"

# Database Configuration (matches docker-compose)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="codebeast"

# Redis & Celery Message Broker
REDIS_URL="redis://localhost:6379/0"

# --- API KEYS (Strictly Groq and NaraRouter) ---
# REQUIRED: Your GitHub Personal Access Token
# Prevents rate-limiting when the Context Builder pulls repository metadata & AST clones.
GITHUB_TOKEN="your_github_personal_access_token_here"

# REQUIRED: Model Inference Providers (Groq Cloud & NaraRouter)
# Groq provides ultra-fast Llama-3.3-70B and Llama-3.1-8B multi-agent evaluation.
GROQ_API_KEY="gsk_your_primary_groq_api_key_here"
GROQ_FALLBACK_KEYS="gsk_backup_key_1,gsk_backup_key_2"

# NaraRouter / OpenRouter provides multi-model fallback and consensus validation.
NARAROUTER_API_KEY="sk-nry-your_nararouter_api_key_here"

# (Optional / Legacy: Gemini Flash API Key)
# GEMINI_API_KEY="your_gemini_api_key_here"
